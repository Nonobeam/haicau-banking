DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=central_banking
DB_SCHEMA=public

PORT=8083

HCAU_SERVICE_ID=100

# 32-byte key, Base64-encoded. Generate with: openssl rand -base64 32
# Must match the same key used by all services that share encrypted credentials.
CREDENTIALS_ENCRYPTION_KEY=<generate-with-openssl-rand-base64-32>

# Stripe API secret key (sk_live_... or sk_test_...).
# On first startup, this is encrypted with CREDENTIALS_ENCRYPTION_KEY and stored
# in the providers table. Leave blank on subsequent startups (key is already stored).
STRIPE_SECRET_KEY=<your-stripe-secret-key>
